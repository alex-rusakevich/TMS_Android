<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <com.example.tms_android.CircularProgressView
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressView"
        android:layout_gravity="center"
        app:strokeWidth="@dimen/default_stroke_width"
        app:progressLowColor="@color/progress_low"
        app:progressMediumColor="@color/progress_medium"
        app:progressHighColor="@color/progress_high"
        app:backgroundColor="@color/progress_background"
        app:textColor="@color/text_primary"
        app:animationDuration="5000"/>
</androidx.constraintlayout.widget.ConstraintLayout>